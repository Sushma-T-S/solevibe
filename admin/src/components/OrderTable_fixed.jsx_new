import React, { useState, useCallback } from 'react';
import OrderViewModal from './OrderViewModal';
import TrackOrderModal from './TrackOrderModal';
import { toast } from 'react-hot-toast';
import { getOrderDisplay } from '../hooks/useOrderDisplay';

const OrderTable = ({ orders = [], loading, onStatusUpdate, onView }) => {
  const [expandedOrderId, setExpandedOrderId] = useState(null);
  const [viewOrder, setViewOrder] = useState(null);
  const [trackOrder, setTrackOrder] = useState(null);

  const handleCancel = async (orderId) => {
    if (confirm('Cancel this order group?')) {
      if (onStatusUpdate) onStatusUpdate(orderId, 'cancelled');
      toast.success('Order cancelled!');
    }
  };

  const toggleExpand = useCallback((orderId) => {
    setExpandedOrderId(prev => prev === orderId ? null : orderId);
  }, []);

  const openView = useCallback((order) => {
    setViewOrder(order);
  }, []);

  const openTrack = useCallback((order) => {
    setTrackOrder(order);
  }, []);

  if (loading) {
    return (
      <div className="overflow-x-auto">
        <table className="w-full divide-y divide-slate-200">
          <thead className="bg-slate-50">
            <tr>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Order ID</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Product</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Customer</th>
              <th className="px-6 py-4 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Price</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Payment</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Date</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-200 bg-white">
            {[...Array(6)].map((_, i) => (
              <tr key={`skeleton-${i}`}>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-24"></div></td>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-16"></div></td>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-32"></div></td>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-16"></div></td>
                <td className="px-6 py-4"><div className="w-20 h-6 bg-slate-200 rounded-full"></div></td>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-12"></div></td>
                <td className="px-6 py-4"><div className="h-4 bg-slate-200 rounded w-28"></div></td>
                <td className="px-6 py-4"><div className="w-32 h-8 bg-slate-200 rounded-lg"></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    );
  }

  if (orders.length === 0) {
    return (
      <div className="p-16 text-center border-2 border-dashed border-slate-200 rounded-3xl bg-gradient-to-br from-slate-50 to-indigo-50">
        <div className="w-24 h-24 bg-gradient-to-br from-slate-200 to-slate-300 rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-lg">
          <svg className="w-16 h-16 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 3h18l-2 12H5L3 3zM9 9v6m0-6h6v6H9z" />
          </svg>
        </div>
        <h3 className="text-2xl md:text-3xl font-bold text-slate-900 mb-3">No orders found</h3>
        <p className="text-lg text-slate-500 mb-8 max-w-md mx-auto">Orders will appear here once customers start shopping.</p>
      </div>
    );
  }

  return (
    <>
      <div className="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table className="min-w-full divide-y divide-slate-200">
          <thead className="bg-slate-50">
            <tr>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Order ID</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Product</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Customer</th>
              <th className="px-6 py-4 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Price</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Payment</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Date</th>
              <th className="px-6 py-4 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-slate-200">
            {orders.map((order, index) => {
              const displayProps = getOrderDisplay(order);
              const orderKey = order._id || order.orderGroupId || index;
              const firstItem = displayProps.firstItem || {};
              const productName = firstItem.name || order.product_details?.name || 'N/A';
              const productImage = firstItem.image?.[0] || order.product_details?.image?.[0] || '';
              const itemsCount = displayProps.itemsCount || 1;
              const isExpanded = expandedOrderId === orderKey;
              
              return (
                <React.Fragment key={orderKey}>
                  <tr className="hover:bg-slate-50/75 transition-all group">
                    <td className="px-6 py-5 whitespace-nowrap text-sm font-semibold text-slate-900 border-r border-slate-100">
                      #{order.orderId || order.orderGroupId}
                    </td>
                    <td className="px-6 py-5">
                      <div 
                        className="flex items-center gap-4 cursor-pointer p-3 rounded-2xl group-hover:bg-indigo-50/50 hover:shadow-sm transition-all border border-slate-100 hover:border-indigo-200"
                        onClick={() => toggleExpand(orderKey)}
                      >
                        <div className="relative">
                          <img 
                            src={productImage || '/placeholder.jpg'} 
                            alt={productName}
                            className="w-14 h-14 rounded-xl object-cover ring-2 ring-slate-200/50 hover:ring-indigo-400 shadow-md transition-all flex-shrink-0 hover:shadow-lg hover:scale-105"
                            loading="lazy"
                          />
                          {itemsCount > 1 && (
                            <span className="absolute -top-1 -right-1 bg-indigo-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-bold shadow-lg">
                              {itemsCount}
                            </span>
                          )}
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="font-semibold text-slate-900 text-sm leading-tight line-clamp-2 group-hover:text-indigo-900">
                            {productName}
                          </div>
                          <div className="text-xs text-slate-500 mt-1">View all items</div>
                        </div>
                        <svg className={`w-5 h-5 text-slate-400 transition-transform duration-200 ${isExpanded ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </td>
                    <td className="px-6 py-5">
                      <div className="font-semibold text-slate-900 text-sm">{displayProps.customerName}</div>
                      <div className="text-sm text-slate-600 truncate max-w-[140px]">{displayProps.customerPhone}</div>
                      <div className="text-xs text-slate-500">{displayProps.customerCity}</div>
                    </td>
                    <td className="px-6 py-5 text-right">
                      <div className="text-lg font-bold text-slate-900">₹{displayProps.grandTotal.toLocaleString('en-IN')}</div>
                      <div className="text-xs text-emerald-600 font-medium">{displayProps.paymentDisplay}</div>
                    </td>
                    <td className="px-6 py-5 whitespace-nowrap">
                      <span className={`px-3 py-1.5 rounded-full text-xs font-bold shadow-sm ${displayProps.statusBadgeClass}`}>
                        {displayProps.statusLabel}
                      </span>
                    </td>
                    <td className="px-6 py-5 whitespace-nowrap text-sm text-slate-900 font-medium">
                      {displayProps.formattedDateTime}
                    </td>
                    <td className="px-6 py-5 whitespace-nowrap">
                      <div className="flex gap-2">
                        <button 
                          onClick={(e) => {
                            e.stopPropagation();
                            openView(order);
                          }}
                          className="flex-1 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm hover:shadow-md transition-all whitespace-nowrap"
                        >
                          View
                        </button>
                        <button 
                          onClick={(e) => {
                            e.stopPropagation();
                            openTrack(order);
                          }}
                          className="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-sm hover:shadow-md transition-all whitespace-nowrap"
                        >
                          Track
                        </button>
                      </div>
                    </td>
                  </tr>
                  
                  {/* Expanded Items Row */}
                  {isExpanded && (
                    <tr>
                      <td colSpan="7" className="px-6 py-4 bg-gradient-to-r from-slate-50/70 to-indigo-50/30 backdrop-blur-sm">
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 p-4">
                          {displayProps.items.map((item, idx) => (
                            <div 
                              key={`item-${orderKey}-${idx}`} 
                              className="group flex items-start gap-3 p-4 bg-white/80 backdrop-blur-sm rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:border-indigo-300 hover:-translate-y-0.5 transition-all duration-200"
                            >
                              <img 
                                src={item.image?.[0] || '/placeholder.jpg'} 
                                alt={item.name}
                                className="w-16 h-16 rounded-xl object-cover flex-shrink-0 shadow-md group-hover:shadow-lg group-hover:scale-105 transition-all"
                                loading="lazy"
                              />
                              <div className="min-w-0 flex-1">
                                <div className="font-semibold text-slate-900 text-sm line-clamp-2 leading-tight">{item.name}</div>
                                <div className="flex gap-2 text-xs text-slate-600 mt-1 flex-wrap">
                                  <span className="px-2 py-1 bg-indigo-100 text-indigo-800 rounded-full font-medium">Qty: {item.quantity}</span>
                                  {item.size && <span className="px-2 py-1 bg-slate-100 text-slate-800 rounded-full font-medium">Size: {item.size}</span>}
                                </div>
                                <div className="font-bold text-indigo-600 text-sm mt-1">₹{item.subTotal?.toLocaleString('en-IN')}</div>
                              </div>
                            </div>
                          ))}
                        </div>
                      </td>
                    </tr>
                  )}
                </React.Fragment>
              );
            })}
          </tbody>
        </table>
      </div>

      {viewOrder && (
        <OrderViewModal order={viewOrder} onClose={() => setViewOrder(null)} />
      )}
      {trackOrder && (
        <TrackOrderModal order={trackOrder} onClose={() => setTrackOrder(null)} />
      )}
    </>
  );
};

export default OrderTable;

